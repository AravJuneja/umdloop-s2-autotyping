<?xml version="1.0"?>
<package format="3">
  <name>panel_detect</name>
  <version>0.1.0</version>
  <description>Find the panel's ArUco markers in the camera image.</description>
  <maintainer email="victor.casado.nyc@gmail.com">Victor Casado</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>python3-numpy</depend>
  <depend>autotype_sim</depend>
  <depend>tf2_ros</depend>
  <!-- OpenCV is deliberately not declared: rosdep would resolve it to the
       Ubuntu python3-opencv package, which is 4.6 and predates
       cv2.aruco.ArucoDetector. The environment provides
       opencv-contrib-python-headless 4.10 from pip instead; see
       sim/docker/Dockerfile. -->
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-mypy</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
